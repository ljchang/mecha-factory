# Install: cp scripts/mecha-slots.{service,timer} ~/.config/systemd/user/
#          systemctl --user daemon-reload
#          systemctl --user enable --now mecha-slots.timer
#          loginctl enable-linger "$USER"
#
# Every fifteen minutes — the freshness the design settled on (§13.5 of the
# public-surface doc): a booking page at most fifteen minutes stale degrades
# exactly as youcanbookme does when its sync lags, and the claim step catches
# the difference. Persistent, so a wake owes one refresh, not a backlog.
[Unit]
Description=Refresh booking slots every fifteen minutes

[Timer]
OnCalendar=*:0/15
RandomizedDelaySec=1m
Persistent=true

[Install]
WantedBy=timers.target
