# The slot-refresh pipeline: a scheduled command, deliberately not a mecha
# trigger. Triggers run prompts, and a model transcribing time intervals is a
# model that can mistranscribe them — this path is deterministic end to end,
# costs zero tokens, and works with no agent installed at all.
#
# Install: cp scripts/mecha-slots.{service,timer} ~/.config/systemd/user/
#
# The policy file is the `[availability]` vocabulary (SCHEDULING-DESIGN.md
# §3.1); the instrument id must match what the box serves. Both halves fail
# closed and loudly: an unreadable mailbox, a stale freebusy answer, or busy
# data short of the horizon each stop the push rather than narrowing it,
# because every failure that "degrades gracefully" here degrades into
# offering strangers time the user does not have. The page keeps serving the
# previous cache meanwhile, stale but honest, and says so.
[Unit]
Description=mecha slot refresh (freebusy → availability → box)
After=network-online.target

[Service]
Type=oneshot
# systemd gives a unit a minimal environment; both binaries live in cargo's
# bin. Measured on mecha-triggers.service the hard way.
Environment=PATH=%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/sh -c 'mecha-mail freebusy --days 60 --json | factory-publish slots push book --policy %h/.mecha/instruments/book-policy.toml'
